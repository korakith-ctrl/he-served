{
  "rules": {
    "shops": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "menus": {
          ".read": "auth != null"
        },
        "optionGroups": {
          ".read": "auth != null"
        },
        "promotions": {
          ".read": "auth != null"
        },
        "popupAds": {
          ".read": "auth != null"
        },
        "settings": {
          "shopName": { ".read": "auth != null" },
          "promptpayId": { ".read": "auth != null" },
          "acceptingOrders": { ".read": "auth != null" },
          "slipTestMode": { ".read": "auth != null" },
          "bannerImageUrl": { ".read": "auth != null" },
          "bannerImageUrls": { ".read": "auth != null" },
          "bannerEnabledStates": { ".read": "auth != null" },
          "bannerTransition": { ".read": "auth != null" },
          "categoryOrder": { ".read": "auth != null" },
          "loyaltyBeanGoal": { ".read": "auth != null" },
          "loyaltyRewardValue": { ".read": "auth != null" },
          "seasonalEffect": { ".read": "auth != null" },
          "customerTheme": { ".read": "auth != null" },
          "coffeePass": { ".read": "auth != null" }
        }
      }
    },
    "orders": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$orderId": {
          ".read": "auth != null && (auth.uid === $uid || data.child('customerUid').val() === auth.uid)",
          ".write": "auth != null && (auth.uid === $uid || (!data.exists() && root.child('shops/' + $uid + '/settings/acceptingOrders').val() !== false && newData.child('customerUid').val() === auth.uid && newData.child('customerName').isString() && newData.child('customerName').val().length > 0 && newData.child('customerPhone').isString() && newData.child('paymentMethod').isString() && newData.child('createdAt').isString() && newData.child('items').hasChildren() && newData.child('total').isNumber() && newData.child('total').val() >= 0 && newData.child('status').val() === 'pending' && !newData.hasChild('paymentVerified') && !newData.hasChild('paymentVerifiedBy') && !newData.hasChild('paymentVerifiedAt') && !newData.hasChild('slipRef') && !newData.hasChild('saleRecorded') && !newData.hasChild('source') && !newData.hasChild('redeemedBeans') && !newData.hasChild('beansUsed') && !newData.hasChild('redemptionAttemptId') && !newData.hasChild('coffeePassPurchase') && !newData.hasChild('coffeePassServerCreated') && !newData.hasChild('passRedemption')))",
          "items": {
            "$item": {
              "freeUnit": { ".validate": "auth.uid === $uid" }
            }
          }
        }
      }
    },
    "customers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$phone": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "auditLogs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "sales": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "accounting": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "debtMembers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "debts": {
      "$debtId": {
        ".read": "auth != null && (data.child('creditorUid').val() === auth.uid || data.child('debtorUid').val() === auth.uid)",
        ".write": false
      }
    },
    "debtPayments": {
      "$debtId": {
        ".read": "auth != null && (root.child('debts').child($debtId).child('creditorUid').val() === auth.uid || root.child('debts').child($debtId).child('debtorUid').val() === auth.uid)",
        ".write": false
      }
    },
    "debtChangeRequests": {
      "$debtId": {
        ".read": "auth != null && (root.child('debts').child($debtId).child('creditorUid').val() === auth.uid || root.child('debts').child($debtId).child('debtorUid').val() === auth.uid)",
        ".write": false
      }
    },
    "debtConsentRequests": {
      "$debtId": {
        ".read": "auth != null && (root.child('debts').child($debtId).child('creditorUid').val() === auth.uid || root.child('debts').child($debtId).child('debtorUid').val() === auth.uid)",
        ".write": false
      }
    },
    "debtAgreementVersions": {
      "$debtId": {
        ".read": "auth != null && (root.child('debts').child($debtId).child('creditorUid').val() === auth.uid || root.child('debts').child($debtId).child('debtorUid').val() === auth.uid)",
        ".write": false
      }
    },
    "debtClosures": {
      "$debtId": {
        ".read": "auth != null && (root.child('debts').child($debtId).child('creditorUid').val() === auth.uid || root.child('debts').child($debtId).child('debtorUid').val() === auth.uid)",
        ".write": false
      }
    },
    "debtDisputes": {
      "$debtId": {
        ".read": "auth != null && (root.child('debts').child($debtId).child('creditorUid').val() === auth.uid || root.child('debts').child($debtId).child('debtorUid').val() === auth.uid)",
        ".write": false
      }
    },
    "debtAuditLogs": {
      "$debtId": {
        ".read": "auth != null && (root.child('debts').child($debtId).child('creditorUid').val() === auth.uid || root.child('debts').child($debtId).child('debtorUid').val() === auth.uid)",
        ".write": false
      }
    },
    "debtNotifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "debtArchives": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "debtRateLimits": {
      ".read": false,
      ".write": false
    },
    "debtInviteCodes": {
      ".read": false,
      ".write": false
    },
    "debtInviteClaims": {
      ".read": false,
      ".write": false
    },
    "debtInviteAcceptances": {
      ".read": false,
      ".write": false
    },
    "debtInitializations": {
      ".read": false,
      ".write": false
    }
  }
}
